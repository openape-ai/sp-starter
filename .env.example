# OpenApe SP Configuration
# Copy this file to .env and adjust as needed.

# Fallback Identity Provider (used when no DNS record is found for the user's domain)
NUXT_OPENAPE_SP_FALLBACK_IDP_URL=https://id.openape.at

# Session secret (auto-generated in dev, required for production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUXT_OPENAPE_SP_SESSION_SECRET=

# SP display name (shown on IdP login page)
# NUXT_OPENAPE_SP_NAME=My App

# Client ID (auto-derived from origin in dev, set for production)
# NUXT_OPENAPE_CLIENT_ID=myapp.example.com

# Direct IdP URL (bypasses DNS discovery, useful for development)
# NUXT_OPENAPE_URL=http://localhost:3000
